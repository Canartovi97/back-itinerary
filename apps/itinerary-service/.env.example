PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/itinerary_db
AIRPORT_SERVICE_URL=http://localhost:3001
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# Must match airport-service's JWT_SECRET — this is the only service that
# issues tokens, but both services need the same secret to verify them.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=1h
